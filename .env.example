# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_WS_BASE=ws://localhost:8000

# Backend
APP_ENV=development
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:3000
# Local SQLite fallback: sqlite:///./data/app.db
DATABASE_URL=mysql+pymysql://timewallpaper:timewallpaper@127.0.0.1:3306/timewallpaper?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0
RENDER_QUEUE_ENABLED=true
RENDER_QUEUE_NAME=arq:wallpaper
RENDER_JOB_TIMEOUT_SECONDS=420
RENDER_JOB_MAX_TRIES=3
RENDER_WORKER_MAX_JOBS=2
RENDER_FAMILY_LOCK_SECONDS=480
RENDER_RETRY_DELAYS=5,20,60

# Storage
STORAGE_LOCAL_DIR=./data/uploads

# Shared provider. ASR and LLM use OpenAI-compatible endpoints; image generation can use Gemini generateContent.
PROVIDER_API_BASE_URL=
PROVIDER_API_KEY=

AUDIO_TRANSCRIPTION_MODEL=Doubao-Seed-ASR-2.0
AUDIO_TRANSCRIPTION_LANGUAGE=zh
AUDIO_TRANSCRIPTION_ENDPOINT=https://openspeech.bytedance.com/api/v3/auc/bigmodel/recognize/flash
DOUBAO_ASR_API_KEY=
DOUBAO_ASR_RESOURCE_ID=volc.bigasr.auc_turbo
DOUBAO_STREAMING_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_nostream
DOUBAO_STREAMING_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
DOUBAO_STREAMING_ASR_CA_BUNDLE=/etc/ssl/cert.pem
DOUBAO_STREAMING_ASR_CONNECT_TIMEOUT_SECONDS=10
DOUBAO_STREAMING_ASR_RESULT_TIMEOUT_SECONDS=30

LLM_API_BASE_URL=
LLM_API_KEY=
LLM_CHAT_MODEL=deepseek-v4-pro
LLM_TEMPERATURE=0.2
LLM_CHAT_ENDPOINT=

CHATBOT_LLM_API_BASE_URL=
CHATBOT_LLM_API_KEY=
CHATBOT_LLM_CHAT_ENDPOINT=
CHATBOT_LLM_MODEL=deepseek-v4-pro
CHATBOT_LLM_TEMPERATURE=0.2
CHATBOT_ENABLE_THINKING=false
CHATBOT_TIMEOUT_SECONDS=12

IMAGE_CHAT_MODEL=gpt-4o-image
IMAGE_CHAT_ENDPOINT=
IMAGE_ASPECT_RATIO=1:1
IMAGE_SIZE=1536x1536

# Character portraits use Volcengine Seedream independently from wallpaper size.
CHARACTER_IMAGE_SIZE=768x1024
CHARACTER_IMAGE_TIMEOUT_SECONDS=300
CHARACTER_IMAGE_RETRIES=1
