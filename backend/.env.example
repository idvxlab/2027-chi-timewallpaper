APP_ENV=development
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:3000
STORAGE_LOCAL_DIR=./data/uploads
PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Shared provider. For official OpenAI, use https://api.openai.com.
PROVIDER_API_BASE_URL=
PROVIDER_API_KEY=

# ChatBox ASR + Audio Understanding Tool example:
# - ChatBox ASR uses AUDIO_TRANSCRIPTION_* to turn microphone/audio into transcript.
# - Audio Understanding Tool uses the same audio model only for voice affect/tone analysis.
# PROVIDER_API_BASE_URL=https://ark.cn-beijing.volces.com
# AUDIO_TRANSCRIPTION_MODEL=doubao-seed-2-0-mini-260428
# AUDIO_TRANSCRIPTION_ENDPOINT=/api/v3/chat/completions
# PUBLIC_API_BASE_URL must be a public URL/tunnel if the upstream needs to fetch uploaded audio.
AUDIO_TRANSCRIPTION_MODEL=whisper-1
AUDIO_TRANSCRIPTION_LANGUAGE=zh
AUDIO_TRANSCRIPTION_ENDPOINT=

LLM_CHAT_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_CHAT_ENDPOINT=

IMAGE_CHAT_MODEL=gpt-image-2
IMAGE_CHAT_ENDPOINT=
IMAGE_EDIT_ENDPOINT=
IMAGE_ASPECT_RATIO=9:16
IMAGE_SIZE=1024x1536
IMAGE_REQUEST_TIMEOUT_SECONDS=300
IMAGE_REQUEST_RETRIES=0
IMAGE_DOWNLOAD_TIMEOUT_SECONDS=60
LAYERED_IMAGE_TOOLS_ENABLED=true
