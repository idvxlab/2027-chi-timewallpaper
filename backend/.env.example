APP_ENV=development
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:3000
# Local SQLite fallback: sqlite:///./data/app.db
DATABASE_URL=mysql+pymysql://timewallpaper:timewallpaper@127.0.0.1:3306/timewallpaper?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0
RENDER_QUEUE_ENABLED=true
RENDER_QUEUE_NAME=arq:wallpaper
RENDER_JOB_TIMEOUT_SECONDS=420
RENDER_JOB_MAX_TRIES=3
RENDER_WORKER_MAX_JOBS=2
RENDER_FAMILY_LOCK_SECONDS=480
RENDER_RETRY_DELAYS=5,20,60
STORAGE_LOCAL_DIR=./data/uploads
PUBLIC_API_BASE_URL=http://127.0.0.1:8000
STATIC_BASE_SCENE_URL=/generated/wallpaper-main-square-1536.png

# Shared provider. For official OpenAI, use https://api.openai.com.
PROVIDER_API_BASE_URL=
PROVIDER_API_KEY=

# Pure speech-to-text via Doubao Seed ASR 2.0 recorded-file flash API.
# DOUBAO_ASR_API_KEY comes from the Doubao Speech console, not Ark/Seedream.
AUDIO_TRANSCRIPTION_MODEL=Doubao-Seed-ASR-2.0
AUDIO_TRANSCRIPTION_LANGUAGE=zh
AUDIO_TRANSCRIPTION_ENDPOINT=https://openspeech.bytedance.com/api/v3/auc/bigmodel/recognize/flash
DOUBAO_ASR_API_KEY=
DOUBAO_ASR_RESOURCE_ID=volc.bigasr.auc_turbo
DOUBAO_STREAMING_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_nostream
DOUBAO_STREAMING_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
DOUBAO_STREAMING_ASR_CA_BUNDLE=/etc/ssl/cert.pem
DOUBAO_STREAMING_ASR_CONNECT_TIMEOUT_SECONDS=10
DOUBAO_STREAMING_ASR_RESULT_TIMEOUT_SECONDS=30

# Optional independent OpenAI-compatible provider for all text agents.
# Example gateway from api使用文档(2).pdf:
# LLM_API_BASE_URL=https://apicz.boyuerichdata.com
# LLM_API_KEY=sk-your-gateway-token
# LLM_CHAT_ENDPOINT=https://apicz.boyuerichdata.com/v1/chat/completions
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_CHAT_MODEL=deepseek-v4-pro
LLM_TEMPERATURE=0.2
LLM_CHAT_ENDPOINT=

# Independent ChatBot model. Empty provider/key/endpoint values inherit LLM_*.
CHATBOT_LLM_API_BASE_URL=
CHATBOT_LLM_API_KEY=
CHATBOT_LLM_CHAT_ENDPOINT=
CHATBOT_LLM_MODEL=deepseek-v4-pro
CHATBOT_LLM_TEMPERATURE=0.2
CHATBOT_ENABLE_THINKING=false
CHATBOT_TIMEOUT_SECONDS=12

IMAGE_CHAT_MODEL=gpt-image-2
IMAGE_CHAT_ENDPOINT=
IMAGE_EDIT_ENDPOINT=
IMAGE_ASPECT_RATIO=1:1
IMAGE_SIZE=1536x1536
IMAGE_REQUEST_TIMEOUT_SECONDS=300
IMAGE_REQUEST_RETRIES=0
IMAGE_DOWNLOAD_TIMEOUT_SECONDS=60
LAYERED_IMAGE_TOOLS_ENABLED=true

# Volcengine Seedream image provider for shared-wallpaper rendering.
# Keep this key separate from PROVIDER_API_KEY so text/audio providers cannot
# accidentally send a key from another platform to Volcengine.
VOLCENGINE_IMAGE_API_KEY=
VOLCENGINE_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_IMAGE_MODEL=doubao-seedream-5-0-260128
VOLCENGINE_IMAGE_SIZE=1536x1536
VOLCENGINE_IMAGE_RESPONSE_FORMAT=b64_json
VOLCENGINE_IMAGE_TIMEOUT_SECONDS=300
VOLCENGINE_IMAGE_MAX_DOWNLOAD_BYTES=50000000
VOLCENGINE_IMAGE_PASS2_RETRIES=1
VOLCENGINE_IMAGE_UPDATE_RETRIES=1

# Character portrait generation also uses the Seedream provider above.
# The provider generates a larger same-ratio source and stores 768x1024.
CHARACTER_IMAGE_SIZE=768x1024
CHARACTER_IMAGE_TIMEOUT_SECONDS=300
CHARACTER_IMAGE_RETRIES=1
