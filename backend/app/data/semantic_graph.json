      ],
      "parameters": {"object_specificity": "high"},
      "must_include": ["文本中提取出的具体物件"],
      "avoid": ["把具体物件替换成泛化类别"]
    },
    {
      "id": "short.momentary_affect",
      "field": "momentary_affect",
      "semantic_slot": "B_affective_semantics.momentary_affect",
      "semantic_variable": "Momentary Affect / 当下情绪类型",
      "category": "B Affective Semantics / 情绪状态语义",
      "content_type": "mapped_semantic_metaphor",
      "strategy": "exact_then_semantic_retrieval",
      "values": ["愉悦", "平静", "悲伤", "焦虑", "思念", "期待", "疲惫"],
      "aliases": ["开心", "安心", "难过", "担心", "牵挂", "盼望", "好累", "累", "疲劳"],
      "mapping_layers": ["L1", "L4"],
      "aigc_visual_mapping": "画面色温和角色表情、姿态、动作状态共同表达情绪。",
      "role": "决定画面情绪基调、人物表情和关系路径质感。",
      "visual_metaphors": [
        {"id": "warm_gentle_affect", "description": "愉悦和平静用柔和暖光、自然呼吸感、舒展姿态表达。"},
        {"id": "longing_distance_light", "description": "思念和期待用远距离光带、窗光、抬头望向右上方或细微路径表达。"},
        {"id": "care_needed_soft_shadow", "description": "悲伤和焦虑用低饱和、轻阴影和被保护的空间表达，避免过度戏剧化。"},
        {"id": "fatigue_low_motion", "description": "疲惫用较低动势、放慢的姿态、深夜柔暗光和被照顾的空间边界表达。"}
      ],
      "parameters": {"color_temperature": "semantic", "saturation": "semantic", "facial_expression_clarity": "medium"},
      "must_include": ["情绪可读的光线或姿态"],
      "avoid": ["夸张哭泣", "恐怖压抑", "过度戏剧化"]
    },
    {
      "id": "short.affective_intensity",
      "field": "affective_intensity",
      "semantic_slot": "B_affective_semantics.affective_intensity",
      "semantic_variable": "Affective Intensity / 情绪强度",
      "category": "B Affective Semantics / 情绪状态语义",
      "content_type": "parameter_control",
      "strategy": "exact_rule",
      "values": ["轻微", "明显", "强烈", "波动"],
      "mapping_layers": ["L1"],
      "aigc_visual_mapping": "画面饱和度变化。",
      "role": "把程度词转成视觉强度参数。",
      "scale": {"轻微": 0.25, "明显": 0.55, "强烈": 0.8, "波动": 0.65},
      "visual_metaphors": [
        {"id": "intensity_to_saturation", "description": "情绪越强，色彩饱和度、光照密度和路径可见性越明显。"}
      ],
      "parameters": {"visual_strength": "scaled", "saturation": "scaled"},
      "must_include": [],
      "avoid": ["强度过度放大导致画面压迫"]
    },
    {
      "id": "short.affective_ambiguity",
      "field": "affective_ambiguity",
      "semantic_slot": "B_affective_semantics.affective_ambiguity",
      "semantic_variable": "Affective Ambiguity / 情绪模糊度",
      "category": "B Affective Semantics / 情绪状态语义",
      "content_type": "parameter_control",
      "strategy": "exact_rule",
      "values": ["明确", "含混", "难以判断", "需要上下文"],
      "mapping_layers": ["L1", "L4"],
      "aigc_visual_mapping": "人脸、姿态、动作、表情清晰度。",
      "role": "控制表情清晰度和隐喻明确度，避免过度解读。",
      "scale": {"明确": 0.85, "含混": 0.45, "难以判断": 0.25, "需要上下文": 0.35},
      "visual_metaphors": [
        {"id": "ambiguity_to_soft_focus", "description": "语义越不确定，表情越柔和、隐喻越轻、边界越模糊。"}
      ],
      "parameters": {"facial_expression_clarity": "scaled", "symbol_explicitness": "scaled"},
      "must_include": [],
      "avoid": ["把不确定情绪画成确定结论"]
    },
    {
      "id": "short.intent_type",
      "field": "intent_type",
      "semantic_slot": "C_communicative_semantics.intent_type",
      "semantic_variable": "Intent Type / 沟通意图类型",
      "category": "C Communicative Semantics / 沟通意图语义",
      "content_type": "mapped_semantic_metaphor",
      "strategy": "exact_then_semantic_retrieval",
      "values": ["分享生活", "表达思念", "寻求安慰", "倾诉情绪", "期待回应"],
      "mapping_layers": ["L2", "L5"],
      "aigc_visual_mapping": "通过叙事焦点、连接线索、回应提示来突出分享动机。",
      "role": "决定关系路径为什么出现，以及它需要引导什么回应。",
      "visual_metaphors": [
        {"id": "life_sharing_path", "description": "分享生活用低压力的生活痕迹、纸条、香气或小径从左下延伸到右上；主连接应是小路、桥、走廊、河岸、庭院路径等空间路径，光点只能作为路径上的点缀。"},
        {"id": "longing_thread", "description": "表达思念用较长的空间路径、窗光、远方影像和留白表达距离中的牵挂；光只作为路径氛围，不替代路径本身。"},
        {"id": "comfort_shelter", "description": "寻求安慰用包裹性暖光、靠近的灯、软性边界和可回应入口表达被照顾。"}
      ],
      "parameters": {"interaction_pressure": "semantic", "path_shape": "semantic"},
      "must_include": ["中间关系路径"],
      "avoid": ["没有关系映射的纯场景图", "只有漂浮光点而没有实际空间路径"]
