    {
      "id": "short.desired_response",
      "field": "desired_response",
      "semantic_slot": "C_communicative_semantics.desired_response",
      "semantic_variable": "Desired Response / 期待回应方式",
      "category": "C Communicative Semantics / 沟通意图语义",
      "content_type": "mapped_semantic_metaphor",
      "strategy": "exact_then_semantic_retrieval",
      "values": ["看见即可", "轻触回应", "留言", "回忆", "进一步聊天"],
      "mapping_layers": ["L2", "L5"],
      "aigc_visual_mapping": "灯光闪烁、光点等低压力提示。",
      "role": "把期待回应方式转成低压力或高明确度的交互入口。",
      "visual_metaphors": [
        {"id": "low_pressure_seen", "description": "看见即可用微弱亮点、轻闪窗灯或小范围柔光表达，不催促回应；这些只是局部交互提示，不是中间主路径。"},
        {"id": "touch_reply", "description": "轻触回应用可触摸的光点、花瓣、涟漪或路径节点表达；光点可以点缀在路径上或物件旁，但不能独自组成气泡式连接。"},
        {"id": "deeper_reply", "description": "留言或进一步聊天用更清晰的窗、桌面、纸条或开放空间表达；除非语义明确提到电话或视频，否则不要画成实时通话。"}
      ],
      "parameters": {"social_pressure": "semantic", "feedback_brightness": "semantic"},
      "must_include": ["低压力反馈暗示"],
      "avoid": ["明显按钮", "聊天框", "文字标签", "手机通话画面", "视频通话画面", "举着手机对话"]
    },
    {
