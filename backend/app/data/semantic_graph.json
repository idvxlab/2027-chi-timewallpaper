      ],
      "parameters": {"environment_specificity": "high"},
      "must_include": ["可识别场域结构"],
      "avoid": ["空泛梦幻背景"]
    },
    {
      "id": "short.time",
      "field": "time",
      "semantic_slot": "A_situational_semantics.time",
      "semantic_variable": "Time / 时间状态",
      "category": "A Situational Semantics / 情境事实语义",
      "content_type": "exact_graph_match",
      "strategy": "exact_rule",
      "values": ["清晨", "午后", "黄昏", "深夜", "周末", "节日", "季节", "今天", "这周", "晚上"],
      "mapping_layers": ["L1"],
      "aigc_visual_mapping": "日出、夕阳、夜灯、月光、星空、季节光影。",
      "role": "控制时间光线和季节气氛。",
      "visual_metaphors": [
        {"id": "time_light", "description": "用日出、午后暖光、夕阳、夜灯、月光、节日灯光或季节色彩表达时间。"}
      ],
      "parameters": {"lighting": "time_specific", "contrast": "soft"},
      "must_include": ["时间光线"],
      "avoid": ["与时间矛盾的光照"]
    },
    {
      "id": "short.subject",
      "field": "subject",
      "semantic_slot": "A_situational_semantics.subject",
      "semantic_variable": "Subject / 人物对象",
      "category": "A Situational Semantics / 情境事实语义",
      "content_type": "open_concrete_content",
      "strategy": "direct_visualize",
      "values": ["妈妈", "爸爸", "女儿", "儿子", "父母", "子女", "朋友", "邻居", "同事", "社区合唱团"],
      "mapping_layers": ["L4"],
      "aigc_visual_mapping": "人物角色、群体关系、人物相对位置。",
      "role": "提供人物身份和相对关系；父母位于中央安全区左侧偏下，子女位于中央安全区右侧偏上，双方均不得贴边或越界。",
      "visual_metaphors": [
        {"id": "role_positioning", "description": "人物身份通过年龄、姿态、生活空间和陪伴关系表达。"}
      ],
      "parameters": {"character_identity_stability": "high"},
      "must_include": ["中央安全区左侧偏下的父母人物", "中央安全区右侧偏上的子女人物或生活空间"],
      "avoid": ["无关群像抢占主体"]
    },
    {
      "id": "short.object",
      "field": "object",
      "semantic_slot": "A_situational_semantics.object",
      "semantic_variable": "Object / 物件",
      "category": "A Situational Semantics / 情境事实语义",
      "content_type": "open_concrete_content",
      "strategy": "direct_visualize",
      "values": ["饭菜", "药盒", "行李箱", "书", "照片", "花", "杯子", "门票", "桂花", "歌声", "老歌"],
      "mapping_layers": ["L1", "L3"],
